--//======================================================--// ROLL LOOP--//======================================================
task.spawn(function()

    while true do

        if RollEnabled then

            local Start = os.clock()



            local Success = pcall(function()

                Roll:FireServer()

            end)



            local Took = os.clock() - Start



            if not Success then

                RollDelay = math.min(

                    RollDelay * 2,

                    MaximumDelay

                )

            else

                if Took > RollDelay then

                    RollDelay = math.min(

                        Took * 1.25,

                        MaximumDelay

                    )

                else

                    RollDelay = math.max(

                        RollDelay * 0.95,

                        MinimumDelay

                    )

                end

            end



            task.wait(RollDelay)

        else

            task.wait(0.1)

        end

    end

end)
