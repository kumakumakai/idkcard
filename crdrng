--// AUTO RE-EXECUTE ON TELEPORT
--//======================================================
local queueOnTeleport = queue_on_teleport or queueonteleport

if AutoReexecuteEnabled and type(queueOnTeleport) == "function" then
    -- The executor must provide the script text in this global variable.
    local env = (getgenv and getgenv()) or _G
    local queuedSource = env.DepthRollBattleTowerSource

    if type(queuedSource) == "string" and queuedSource ~= "" then
        pcall(function()
            queueOnTeleport(queuedSource)
        end)
    end
end
